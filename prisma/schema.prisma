// Schnitzy Haus — database schema
// PostgreSQL + Prisma. Money is stored as Decimal(10,2); use lib/serialize.ts
// before sending records to the client (Decimal is not JSON-serialisable).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  CUSTOMER
  ADMIN
  STAFF
  KITCHEN
  DELIVERY
}

enum OrderType {
  PICKUP
  DELIVERY
  DINE_IN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  STRIPE
  CASH
}

enum BookingStatus {
  PENDING
  CONFIRMED
  SEATED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LoyaltyTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum NotificationType {
  ORDER_UPDATE
  BOOKING_CONFIRMATION
  PROMOTION
  LOYALTY
  GENERAL
}

enum PointsReason {
  EARNED_ORDER
  REDEEMED
  MANUAL_ADJUSTMENT
  SIGNUP_BONUS
  EXPIRED
}

enum TableStatus {
  FREE
  OCCUPIED
  RESERVED
  OUT_OF_SERVICE
}

enum InquiryStatus {
  OPEN
  ANSWERED
  CLOSED
}

enum Locale {
  en
  de
}

// ---------------------------------------------------------------------------
// Users & auth
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  password      String?
  firstName     String
  lastName      String
  phone         String?
  role          Role      @default(CUSTOMER)
  image         String?
  locale        Locale    @default(de)
  emailVerified DateTime?
  isDeleted     Boolean   @default(false)

  // notification preferences
  notifyEmail    Boolean @default(true)
  notifyPush     Boolean @default(true)
  notifySms      Boolean @default(false)
  notifyWhatsapp Boolean @default(true)
  notifyMarketing Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts           Account[]
  sessions           Session[]
  addresses          Address[]
  orders             Order[]
  bookings           TableBooking[]
  reviews            Review[]
  loyalty            LoyaltyAccount[]
  pointsTransactions PointsTransaction[]
  notifications      Notification[]
  devices            PushDevice[]
  favorites          Favorite[]
  couponRedemptions  CouponRedemption[]
  activityLogs       ActivityLog[]
  inquiries          Inquiry[]
  passwordResets     PasswordResetToken[]
  emailTokens        EmailVerificationToken[]

  @@index([role])
  @@index([isDeleted])
  @@map("users")
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model Address {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @db.Uuid
  label     String  @default("Home")
  line1     String
  line2     String?
  city      String
  postalCode String
  country   String  @default("DE")
  latitude  Float?
  longitude Float?
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// ---------------------------------------------------------------------------
// Restaurant
// ---------------------------------------------------------------------------

model Restaurant {
  id             String  @id @default(uuid()) @db.Uuid
  slug           String  @unique
  name           String
  description    String? @db.Text
  email          String
  phone          String
  whatsappNumber String?
  address        String
  city           String  @default("")
  postalCode     String  @default("")
  country        String  @default("DE")
  latitude       Float?
  longitude      Float?

  /// { "monday": { "open": "11:00", "close": "22:00", "closed": false }, ... }
  openingHours Json @default("{}")

  cuisineType String  @default("German")
  logoUrl     String?
  bannerUrl   String?

  stripeAccountId String?
  currency        String @default("EUR")
  taxRate         Decimal @default(19.00) @db.Decimal(5, 2)

  deliveryEnabled  Boolean @default(true)
  pickupEnabled    Boolean @default(true)
  dineInEnabled    Boolean @default(true)
  deliveryFee      Decimal @default(3.50) @db.Decimal(10, 2)
  freeDeliveryOver Decimal? @db.Decimal(10, 2)
  deliveryRadiusKm Float   @default(8)
  minOrderAmount   Decimal @default(10.00) @db.Decimal(10, 2)

  /// Loyalty configuration: points earned per currency unit spent, redemption rate, tier thresholds.
  pointsPerCurrency Decimal @default(1.00) @db.Decimal(10, 2)
  pointsPerDiscountUnit Int  @default(100) // 100 points === 1 currency unit
  tierThresholds    Json    @default("{\"SILVER\":250,\"GOLD\":1000,\"PLATINUM\":2500}")

  bookingSlotMinutes  Int @default(30)
  bookingMaxGuests    Int @default(12)
  bookingLeadHours    Int @default(1)
  bookingDurationMins Int @default(90)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders           Order[]
  bookings         TableBooking[]
  reviews          Review[]
  loyaltyAccounts  LoyaltyAccount[]
  coupons          Coupon[]
  tables           RestaurantTable[]
  deliveryZones    DeliveryZone[]
  inquiries        Inquiry[]

  @@map("restaurants")
}

model DeliveryZone {
  id           String  @id @default(uuid()) @db.Uuid
  restaurantId String  @db.Uuid
  name         String
  postalCodes  String[]
  fee          Decimal @db.Decimal(10, 2)
  minOrder     Decimal @default(0) @db.Decimal(10, 2)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@map("delivery_zones")
}

model RestaurantTable {
  id           String      @id @default(uuid()) @db.Uuid
  restaurantId String      @db.Uuid
  number       String
  seats        Int
  location     String?
  status       TableStatus @default(FREE)
  isActive     Boolean     @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  bookings   TableBooking[]

  @@unique([restaurantId, number])
  @@map("restaurant_tables")
}

// ---------------------------------------------------------------------------
// Menu
// ---------------------------------------------------------------------------
// The menu itself is hardcoded in lib/menu-data.ts, not stored here. `menuItemId`
// fields below are plain strings matching an id from that file — not a foreign
// key — so they're free-standing snapshots rather than joins.

model Favorite {
  id         String @id @default(uuid()) @db.Uuid
  userId     String @db.Uuid
  menuItemId String

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, menuItemId])
  @@map("favorites")
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

model Order {
  id           String @id @default(uuid()) @db.Uuid
  restaurantId String @db.Uuid
  customerId   String? @db.Uuid
  orderNumber  String @unique

  subtotal       Decimal @db.Decimal(10, 2)
  tax            Decimal @db.Decimal(10, 2)
  deliveryFee    Decimal @default(0) @db.Decimal(10, 2)
  discountAmount Decimal @default(0) @db.Decimal(10, 2)
  tipAmount      Decimal @default(0) @db.Decimal(10, 2)
  totalAmount    Decimal @db.Decimal(10, 2)

  couponCode   String?
  pointsRedeemed Int   @default(0)
  pointsEarned   Int   @default(0)

  orderType OrderType
  status    OrderStatus @default(PENDING)

  // Contact / delivery snapshot (kept on the order so history is immutable)
  customerName  String
  customerEmail String
  customerPhone String

  deliveryAddress    String?
  deliveryPostalCode String?
  deliveryCity       String?
  deliveryLat        Float?
  deliveryLng        Float?

  paymentStatus         PaymentStatus @default(PENDING)
  paymentMethod         PaymentMethod @default(STRIPE)
  stripePaymentIntentId String?
  stripeRefundId        String?
  paidAt                DateTime?

  specialNotes          String?  @db.Text
  scheduledFor          DateTime?
  estimatedDeliveryTime DateTime?
  actualDeliveryTime    DateTime?
  cancelledAt           DateTime?
  cancellationReason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant    Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  customer      User?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  review        Review?
  statusHistory OrderStatusEvent[]
  notifications Notification[]
  pointsTx      PointsTransaction[]
  redemption    CouponRedemption?

  @@index([restaurantId, status])
  @@index([customerId, createdAt])
  @@index([createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

/// Line items are a relation (not a JSON blob) so best-seller analytics can be
/// answered with a groupBy instead of a full scan. Name/price are snapshotted
/// at order time so menu edits never rewrite order history.
model OrderItem {
  id         String  @id @default(uuid()) @db.Uuid
  orderId    String  @db.Uuid
  /// Id of an entry in lib/menu-data.ts at order time — not a foreign key, so
  /// editing or removing that entry later never touches past orders.
  menuItemId String?

  name         String
  unitPrice    Decimal @db.Decimal(10, 2)
  quantity     Int
  lineTotal    Decimal @db.Decimal(10, 2)
  specialNotes String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([menuItemId])
  @@map("order_items")
}

model OrderStatusEvent {
  id        String      @id @default(uuid()) @db.Uuid
  orderId   String      @db.Uuid
  status    OrderStatus
  note      String?
  createdBy String?     @db.Uuid
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_events")
}

/// Monotonic per-day counter backing human-readable order numbers (SH-20260807-0001).
model OrderCounter {
  day   String @id
  value Int    @default(0)

  @@map("order_counters")
}

model BookingCounter {
  day   String @id
  value Int    @default(0)

  @@map("booking_counters")
}

// ---------------------------------------------------------------------------
// Bookings
// ---------------------------------------------------------------------------

model TableBooking {
  id            String @id @default(uuid()) @db.Uuid
  restaurantId  String @db.Uuid
  customerId    String? @db.Uuid
  bookingNumber String @unique

  numberOfGuests Int
  bookingDate    DateTime @db.Date
  bookingTime    String // "19:30" local restaurant time
  startsAt       DateTime // resolved UTC instant, used for conflict detection
  endsAt         DateTime

  tableId     String? @db.Uuid
  tableNumber String?

  customerName  String
  customerEmail String
  customerPhone String

  specialRequests String? @db.Text
  occasion        String?

  status             BookingStatus @default(CONFIRMED)
  cancellationReason String?
  cancelledAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer   User?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  table      RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)

  @@index([restaurantId, bookingDate])
  @@index([customerId, bookingDate])
  @@index([startsAt, endsAt])
  @@map("table_bookings")
}

// ---------------------------------------------------------------------------
// Reviews
// ---------------------------------------------------------------------------

model Review {
  id           String  @id @default(uuid()) @db.Uuid
  restaurantId String  @db.Uuid
  orderId      String? @unique @db.Uuid
  customerId   String  @db.Uuid

  rating  Int
  title   String?
  comment String? @db.Text

  /// string[] of image URLs
  images Json @default("[]")

  status       ReviewStatus @default(PENDING)
  adminResponse String?     @db.Text
  respondedAt  DateTime?
  reportCount  Int          @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order      Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customer   User       @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([restaurantId, status, createdAt])
  @@index([customerId])
  @@map("reviews")
}

// ---------------------------------------------------------------------------
// Loyalty
// ---------------------------------------------------------------------------

model LoyaltyAccount {
  id           String @id @default(uuid()) @db.Uuid
  restaurantId String @db.Uuid
  customerId   String @db.Uuid

  points         Int         @default(0)
  lifetimePoints Int         @default(0)
  tier           LoyaltyTier @default(BRONZE)
  totalSpent     Decimal     @default(0) @db.Decimal(10, 2)
  orderCount     Int         @default(0)
  lastRedeemDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant   Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer     User                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transactions PointsTransaction[]

  @@unique([restaurantId, customerId])
  @@index([tier])
  @@map("loyalty_accounts")
}

model PointsTransaction {
  id        String       @id @default(uuid()) @db.Uuid
  accountId String       @db.Uuid
  userId    String       @db.Uuid
  orderId   String?      @db.Uuid
  points    Int // positive = earned, negative = redeemed
  reason    PointsReason
  note      String?

  createdAt DateTime @default(now())

  account LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  order   Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([accountId, createdAt])
  @@index([userId, createdAt])
  @@map("points_transactions")
}

// ---------------------------------------------------------------------------
// Coupons
// ---------------------------------------------------------------------------

model Coupon {
  id           String @id @default(uuid()) @db.Uuid
  restaurantId String @db.Uuid
  code         String @unique

  description   String?
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(10, 2)

  minOrderAmount Decimal? @db.Decimal(10, 2)
  maxDiscount    Decimal? @db.Decimal(10, 2)

  usageLimit     Int?
  usageCount     Int  @default(0)
  perUserLimit   Int? @default(1)

  validFrom DateTime
  validTo   DateTime
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant  Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  redemptions CouponRedemption[]

  @@index([restaurantId, isActive])
  @@map("coupons")
}

model CouponRedemption {
  id       String  @id @default(uuid()) @db.Uuid
  couponId String  @db.Uuid
  userId   String? @db.Uuid
  orderId  String  @unique @db.Uuid
  amount   Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId, userId])
  @@map("coupon_redemptions")
}

// ---------------------------------------------------------------------------
// Notifications & support
// ---------------------------------------------------------------------------

model Notification {
  id      String           @id @default(uuid()) @db.Uuid
  userId  String           @db.Uuid
  type    NotificationType
  title   String
  message String           @db.Text

  relatedOrderId String? @db.Uuid
  link           String?

  isRead   Boolean @default(false)
  isPushed Boolean @default(false)

  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [relatedOrderId], references: [id], onDelete: SetNull)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

model PushDevice {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @db.Uuid
  token     String  @unique
  platform  String  @default("web")
  userAgent String?
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_devices")
}

model Inquiry {
  id           String        @id @default(uuid()) @db.Uuid
  restaurantId String        @db.Uuid
  userId       String?       @db.Uuid
  name         String
  email        String
  phone        String?
  subject      String
  message      String        @db.Text
  response     String?       @db.Text
  status       InquiryStatus @default(OPEN)
  respondedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([restaurantId, status])
  @@map("inquiries")
}

model ActivityLog {
  id       String  @id @default(uuid()) @db.Uuid
  userId   String? @db.Uuid
  action   String
  entity   String?
  entityId String?
  meta     Json?
  ip       String?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([entity, entityId])
  @@map("activity_logs")
}
