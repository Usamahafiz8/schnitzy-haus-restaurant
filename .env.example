# ---------------------------------------------------------------------------
# Schnitzy Haus — environment variables
# Copy to .env.local (Next.js) / .env (Prisma CLI) and fill in.
# Only NEXT_PUBLIC_* values are exposed to the browser.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/schnitzy_haus"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Auth (NextAuth v5) -----------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST="true"
# Optional Google social login
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Stripe -----------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# From `stripe listen --forward-to localhost:3000/api/payment/webhook`
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Google Maps ------------------------------------------------------------
# Browser key: restrict by HTTP referrer. Enable Maps JavaScript + Places + Geocoding.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
# Server key used for geocoding / distance calculations (unrestricted-by-referrer)
GOOGLE_MAPS_SERVER_KEY=""

# --- Email (SMTP / SendGrid) ------------------------------------------------
EMAIL_FROM="Schnitzy Haus <no-reply@schnitzyhaus.de>"
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT="587"
SMTP_USER="apikey"
SMTP_PASSWORD=""
# When unset, emails are logged to the console instead of being sent.

# --- WhatsApp (Twilio) ------------------------------------------------------
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Sandbox default: whatsapp:+14155238886
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# --- Firebase Cloud Messaging ----------------------------------------------
# Client (web push)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""
# Server (admin SDK) — paste the full service-account JSON on one line
FIREBASE_SERVICE_ACCOUNT_JSON=""

# --- File uploads (S3-compatible) ------------------------------------------
# When unset, uploads are written to ./public/uploads (development only).
S3_REGION="eu-central-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_PUBLIC_URL=""

# --- Caching (optional) -----------------------------------------------------
REDIS_URL=""

# --- Monitoring (optional) --------------------------------------------------
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
