# ---------------------------------------------------------------------------
# Schnitzy Haus — environment variables
# Copy to .env.local (Next.js) / .env (Prisma CLI) and fill in.
# Only NEXT_PUBLIC_* values are exposed to the browser.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/schnitzy_haus"
# Only needed once you're on a real domain — code falls back to localhost:3000.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Auth (NextAuth v5) -----------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
